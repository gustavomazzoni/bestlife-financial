# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace package)
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage
playwright-report
test-results

# next.js
.next/
out/

# production
build

# expo / react native (apps/mobile)
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.production
apps/mobile/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local workspace
*.code-workspace

# Prisma generated folder
apps/web/src/generated
