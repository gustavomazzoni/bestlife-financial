{
  "name": "lifeos-financial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @lifeos/web dev",
    "build": "pnpm --filter @lifeos/web build",
    "start": "pnpm --filter @lifeos/web start",
    "lint": "pnpm --filter @lifeos/web lint",
    "lint:fix": "pnpm --filter @lifeos/web lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @lifeos/web test",
    "test:integration": "pnpm --filter @lifeos/web test:integration",
    "test:e2e": "pnpm --filter @lifeos/web test:e2e",
    "test:all": "pnpm --filter @lifeos/web test:all",
    "type-check": "pnpm --filter @lifeos/web type-check && pnpm --filter @lifeos/shared type-check",
    "prisma:generate": "pnpm --filter @lifeos/web prisma:generate",
    "prisma:migrate": "pnpm --filter @lifeos/web prisma:migrate",
    "prisma:studio": "pnpm --filter @lifeos/web prisma:studio",
    "prisma:seed": "pnpm --filter @lifeos/web prisma:seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "apps/web/node_modules/.bin/eslint --fix --config apps/web/eslint.config.mjs",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  }
}
