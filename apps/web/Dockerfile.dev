# Dockerfile.dev - Multi-stage development image
# Build context is the monorepo ROOT (see docker-compose.yml), not this
# directory, so the pnpm workspace (root manifest + packages/shared) is
# visible for install/linking.
FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.26.0 --activate

# Set working directory
WORKDIR /app

# Install dependencies for native modules
RUN apk add --no-cache libc6-compat openssl

# Configure pnpm to use local store
RUN pnpm config set store-dir /app/.pnpm-store

# Development stage
FROM base AS development

# Copy workspace manifests first for better layer caching
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json

# Install dependencies (including dev dependencies) (Use shamefully-hoist to avoid store location issues)
RUN pnpm install --frozen-lockfile --shamefully-hoist

# Copy application code
COPY . .

# prisma.config.ts requires DATABASE_URL to resolve; env_file (docker-compose)
# only applies at container runtime, not during this build, so it must be
# passed explicitly as a build arg.
ARG DATABASE_URL
ENV DATABASE_URL=$DATABASE_URL

# Generate Prisma Client
RUN pnpm --filter @lifeos/web prisma:generate

# Expose ports
EXPOSE 3000 5555

# Re-syncs node_modules against the lockfile on every container start, since
# anonymous node_modules volumes (docker-compose.yml) persist across image
# rebuilds and would otherwise shadow this image's freshly-installed deps.
COPY docker/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh
ENTRYPOINT ["entrypoint.dev.sh"]

# Default command (can be overridden in docker-compose)
CMD ["pnpm", "--filter", "@lifeos/web", "dev"]
