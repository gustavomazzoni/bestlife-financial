# Dockerfile.dev - Multi-stage development image
# Build context is the monorepo ROOT (see docker-compose.yml), not this
# directory, so the pnpm workspace (root manifest + packages/shared) is
# visible for install/linking.
FROM node:20-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.26.0 --activate

# Set working directory
WORKDIR /app

# Install dependencies for native modules
RUN apk add --no-cache libc6-compat openssl

# Configure pnpm to use local store
RUN pnpm config set store-dir /app/.pnpm-store

# Development stage
FROM base AS development

# Copy workspace manifests first for better layer caching
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json

# Install dependencies (including dev dependencies) (Use shamefully-hoist to avoid store location issues)
RUN pnpm install --frozen-lockfile --shamefully-hoist

# Copy application code
COPY . .

# Generate Prisma Client
RUN pnpm --filter @lifeos/web prisma:generate

# Expose ports
EXPOSE 3000 5555

# Default command (can be overridden in docker-compose)
CMD ["pnpm", "--filter", "@lifeos/web", "dev"]
