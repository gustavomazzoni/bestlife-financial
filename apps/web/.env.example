# Reference only — Docker reads env vars from the repo-root `.env` (see
# `env_file:` on the `app`/`prisma-studio` services in docker-compose.yml,
# and Docker Compose's own `${VAR}` substitution, which also requires a
# root-level file). Copy this template to the repo root, not here, unless
# you're running `next dev` directly on the host outside Docker.

# Database
DATABASE_URL="postgresql://lifeos:lifeos_dev_password@postgres:5432/lifeos_financial?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev_secret_change_in_production_minimum_32_chars_long"

# Email (Development - using Mailpit)
RESEND_API_KEY="re_fake_key_for_dev" # Not needed with Mailpit
SMTP_HOST="mailpit"
SMTP_PORT="1025"
SMTP_FROM="noreply@lifeos.local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NODE_ENV intentionally not set here — Next.js manages it automatically
# (development for `next dev`, production for `next build`/`next start`).
# An explicit "development" here leaks into `next build` via Docker's
# env_file and breaks the /_global-error prerender at build time.

# Redis (Future)
REDIS_URL="redis://redis:6379"

# Feature Flags
ENABLE_GAMIFICATION="true"
ENABLE_EMAIL_NOTIFICATIONS="true"

# LLM transaction inference — options: openai | rule-based
LLM_PROVIDER="rule-based"
OPENAI_API_KEY=""